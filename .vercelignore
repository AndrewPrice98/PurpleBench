# Keep local-only and non-runtime files out of Vercel uploads (git deploys already skip git-ignored files).
# backend/data and backend/rules stay: the recorded telemetry, technique library, demo fixture and rules are
# read at runtime.
backend/.venv
backend/.env
backend/data/*.db
backend/data/*.db-*
backend/data/lab_events
backend/tests
backend/scripts
**/__pycache__
.pytest_cache
node_modules
dist
docs
lab
e2e
screenshots
DECISIONS.md
THIRD_PARTY.md
