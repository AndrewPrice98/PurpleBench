# Copy to backend/.env (git-ignored) or set these in your hosting provider. Names only: no real values here.
# Real environment variables always win over this file. `python -m purplebench create-admin` writes the
# three admin values for you.

# --- admin login (without these, nobody can sign in) ---
PURPLEBENCH_ADMIN_USER=admin
PURPLEBENCH_ADMIN_PASSWORD_HASH=
PURPLEBENCH_SECRET_KEY=

# --- server (optional lines are commented out; a blank value is treated as unset) ---
# PURPLEBENCH_DB=
# PURPLEBENCH_DATA_DIR=
PURPLEBENCH_SESSION_HOURS=8
PURPLEBENCH_COOKIE_SECURE=true
PURPLEBENCH_TRUST_PROXY=false
# PURPLEBENCH_MAX_UPLOAD_MB=

# --- hosted demo ---
PURPLEBENCH_DEMO=false
# PURPLEBENCH_GUEST=
